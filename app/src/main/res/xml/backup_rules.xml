<?xml version="1.0" encoding="utf-8"?><!--
   Auto-backup rules (API <= 30). The EncryptedSharedPreferences file is
   excluded on purpose: its ciphertext is unrecoverable after a restore
   because the Android Keystore master key never leaves the device, and a
   corrupted secrets file would crash the app on every launch.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="lingoflow_secrets.xml"/>
</full-backup-content>
