<?xml version="1.0" encoding="utf-8"?><!--
   Cloud-backup / device-transfer rules (API 31+). The EncryptedSharedPreferences
   file is excluded: restored ciphertext cannot be decrypted without the
   original device's Keystore master key.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lingoflow_secrets.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lingoflow_secrets.xml"/>
    </device-transfer>
</data-extraction-rules>
